python_binary_host {
    name: "nx809j-patch-camera-provider",
    main: "patch_provider.py",
    srcs: ["patch_provider.py"],
}

genrule {
    name: "nx809j-camera-provider-patched",
    tools: ["nx809j-patch-camera-provider"],
    srcs: ["provider/vendor.qti.camera.provider-service_64"],
    out: ["nx809j-camera-provider"],
    cmd: "$(location nx809j-patch-camera-provider) --input $(in) --output $(out)",
}

cc_prebuilt_binary {
    name: "nx809j-camera-provider",
    device_specific: true,
    compile_multilib: "64",
    srcs: [":nx809j-camera-provider-patched"],
    relative_install_path: "hw",
    strip: { none: true },
    // The validated OEM executable retains its original vendor dependency set.
    check_elf_files: false,
}

cc_library_shared {
    name: "libnx809j_camera_provider",
    device_specific: true,
    compile_multilib: "64",
    srcs: [
        "CameraProviderAdapter.cpp",
        "CameraProviderRegistration.cpp",
        "CameraIdMapping.cpp",
        "CameraResultAdapter.cpp",
        "CameraSessionAdapter.cpp",
        "PhysicalCameraMetadata.cpp",
    ],
    shared_libs: [
        "android.hardware.camera.provider-V3-ndk",
        "android.hardware.camera.device-V3-ndk",
        "libbinder_ndk",
        "libcamera_metadata",
        "libdl",
        "libfmq",
        "libbase",
        "libcutils",
        "liblog",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror", "-fvisibility=hidden"],
    cpp_std: "c++20",
}

cc_test {
    name: "nx809j-camera-metadata-test",
    srcs: ["PhysicalCameraMetadata.cpp", "tests/PhysicalCameraMetadataTest.cpp"],
    local_include_dirs: ["."],
    shared_libs: ["libcamera_metadata"],
    compile_multilib: "64",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cpp_std: "c++20",
}

cc_test {
    name: "nx809j-camera-provider-test",
    device_specific: true,
    compile_multilib: "64",
    srcs: [
        "CameraProviderAdapter.cpp",
        "CameraIdMapping.cpp",
        "CameraResultAdapter.cpp",
        "CameraSessionAdapter.cpp",
        "PhysicalCameraMetadata.cpp",
        "tests/CameraProviderAdapterTest.cpp",
        "tests/CameraResultAdapterTest.cpp",
        "tests/CameraSessionAdapterTest.cpp",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "android.hardware.camera.provider-V3-ndk",
        "android.hardware.camera.device-V3-ndk",
        "libbinder_ndk",
        "libcamera_metadata",
        "libfmq",
        "libbase",
        "libcutils",
        "liblog",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cpp_std: "c++20",
}
