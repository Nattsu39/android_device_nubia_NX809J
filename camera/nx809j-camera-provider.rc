# ODM init is parsed after vendor. Retain the OEM executable, interfaces,
# identity and scheduling. Its ODM copy explicitly links the adapter because
# AT_SECURE disables environment-based preloading in this SELinux domain.
service vendor.camera-provider /odm/bin/hw/nx809j-camera-provider
    override
    interface aidl android.hardware.camera.provider.ICameraProvider/vendor_qti/0
    interface aidl vendor.zte.hardware.camera.transfer.ITransfer/vendor_zte/0
    interface aidl vendor.qti.hardware.camera.offlinecamera.IOfflineCameraService/default
    interface aidl vendor.qti.hardware.camera.aon.IAONService/default
    class hal
    user cameraserver
    group audio camera input drmrpc oem_2907 oem_2912 wakelock
    ioprio rt 4
    capabilities SYS_NICE BLOCK_SUSPEND
    task_profiles CameraServiceCapacity HighPerformance ProcessCapacityHigh
